APP_NAME="Flores Amarillas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://flores-amarillas.vercel.app
APP_LOCALE=es

LOG_CHANNEL=stderr

DB_CONNECTION=sqlite
DB_DATABASE=/app/database/vercel.sqlite

SESSION_DRIVER=cookie
SESSION_LIFETIME=120

CACHE_STORE=array
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync

MAIL_MAILER=log
FILESYSTEM_DISK=local

